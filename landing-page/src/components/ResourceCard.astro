---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="block rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
>
    <h3 class="text-lg font-semibold text-slate-900">
        {title}
    </h3>

    <p class="mt-2 text-sm text-slate-600">
        {description}
    </p>

    <span class="mt-4 inline-flex text-sm font-medium text-blue-600">
        Open Resource →
    </span>
</a>