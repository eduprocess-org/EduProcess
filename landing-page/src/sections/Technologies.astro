---
import { technologies } from "../data/technologies";
---

<section
  id="technologies"
  class="bg-gradient-to-b from-slate-50 via-white to-slate-100 py-28"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">

    <!-- Header -->

    <div class="text-center">

      <span
        class="inline-flex items-center rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold uppercase tracking-widest text-blue-700"
      >
        Technology Stack
      </span>

      <h2
        class="mt-6 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
      >
        Modern Technologies
      </h2>

      <p
        class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600"
      >
        EduProcess was built using a modern technology stack focused on
        scalability, maintainability, security, and cross-platform
        development.
      </p>

    </div>

    <!-- Statistics -->

    <div class="mt-16 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">

      <div
        class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <p class="text-4xl font-bold text-blue-600">
          17+
        </p>

        <p class="mt-2 text-sm uppercase tracking-wider text-slate-500">
          Technologies
        </p>

      </div>

      <div
        class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <p class="text-4xl font-bold text-green-600">
          3
        </p>

        <p class="mt-2 text-sm uppercase tracking-wider text-slate-500">
          Platforms
        </p>

      </div>

      <div
        class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <p class="text-4xl font-bold text-purple-600">
          6
        </p>

        <p class="mt-2 text-sm uppercase tracking-wider text-slate-500">
          Categories
        </p>

      </div>

      <div
        class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <p class="text-4xl font-bold text-orange-500">
          100%
        </p>

        <p class="mt-2 text-sm uppercase tracking-wider text-slate-500">
          Modern Stack
        </p>

      </div>

    </div>

    <!-- Technology Cards -->

    <div
      class="mt-20 grid gap-8 md:grid-cols-2 xl:grid-cols-3"
    >

      {
        technologies.map((group) => (

          <article
            class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl"
          >

            <div class={`h-2 w-full ${group.color}`}></div>

            <div class="p-8">

              <h3
                class="text-xl font-bold text-slate-900"
              >
                {group.category}
              </h3>

              <p
                class="mt-2 text-sm text-slate-500"
              >
                {group.items.length} Technologies
              </p>

              <div
                class="mt-8 flex flex-wrap gap-3"
              >

                {
                  group.items.map((item) => (

                    <div
                      class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 transition-all duration-300 hover:scale-105 hover:border-blue-500 hover:bg-blue-50 hover:shadow-md"
                    >

                      <img
                        src={item.logo}
                        alt={item.name}
                        loading="lazy"
                        class="h-7 w-7 object-contain"
                      />

                      <span
                        class="text-sm font-medium text-slate-700"
                      >
                        {item.name}
                      </span>

                    </div>

                  ))
                }

              </div>

            </div>

          </article>

        ))
      }

    </div>

  </div>

</section>